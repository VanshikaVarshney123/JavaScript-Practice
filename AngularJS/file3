<!DOCTYPE html>
<html>
<head>
  <script src="https://ajax.googleapis.com/ajax/libs/angularjs/1.8.2/angular.min.js"></script>
</head>
<body>

<div ng-app="myApp" ng-controller="sumCtrl">
  First Number: <input type="number" ng-model="a"><br><br>
  Second Number: <input type="number" ng-model="b"><br><br>
  <button ng-click="calculate()">Add</button>
  <h3>Sum = {{ result }}</h3>
</div>

<script>
  var app = angular.module("myApp", []);
  app.controller("sumCtrl", function($scope) {
    $scope.calculate = function() {
      $scope.result = $scope.a + $scope.b;
    };
  });
</script>

</body>
</html>
