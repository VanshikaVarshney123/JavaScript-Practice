// THERE ARE TWO WAYS TO DECLARE OBJECTS IN JS, ONE BY CONSTRUCTOR, SECOND BY LITERALS
// singleton
// object.create

// creating symbol
const sym = Symbol("key1")
// object literals
const user = {
    name : "jack",
    "full name" : "jack washington",
    [sym] : "key1",  // adding symbol
    age : 23,
    working_field : "tech",
    email : "VBArrayas34g@chatgpt.com" ,  
    city : "jaipur"
}
console.log(user.name) // old method to get access of object items
console.log([user.age]);  // new method
console.log(user["full name"]);
console.log(user[sym]);

user.email = "jackW23@gmail.com"
console.log(user.email);
// wanna to lock the info of given key
// Object.freeze(user) 
user.email = "jennieW23@gmail.com"
console.log(user.email);
console.log(user);

user.greeting = function(){
    console.log("Hello , JS user!!!");
}
console.log(user.greeting);  // [Function (anonymous)]
console.log(user.greeting()); // Hello , JS user!!!

user.greeting2 = function(){
    console.log(`Hello JS user , ${this.name}`);
}
console.log(user.greeting2());
