// FOREACH LOOP
const coding = ["js", "ruby", "cpp"] 
// FOREACH ME CALLBQCK FUNCTION DENA HOTA H.. callback funciton me function name nhi dete.. like we decalre function iin js --> function sum(){}  --> here we don't add the name..'sum'
coding.forEach(function (val){
   console.log(val);
})
// using 'arrow function' as callback function
coding.forEach((item) => {
   console.log(item);
}) 

const coding01 = ["js", "ruby", "cpp"]
function printMe(item){  // this item in the parenthesis is parameter
   console.log(item);
}
coding01.forEach(printMe) 
